# CSV export endpoint for the Google Sheets medicines tab. The sheet must be publicly accessible to the app.
# Required headers: nombre, nombreGenerico (optional), dosis, forma (optional), cantidad, vencimiento (YYYY-MM-DD), notas (optional).
MEDICINES_CSV_URL=https://docs.google.com/spreadsheets/d/1e7fxO79EXfscZs9iugG-fvCTO9tVVY3CPz3GUPYYOhs/export?format=csv&gid=0

# CSV export endpoint for the Google Sheets household-supplies tab. The sheet must be publicly accessible to the app.
# Required headers: nombre, cantidad, unidad; notas is optional.
SUPPLIES_CSV_URL=https://docs.google.com/spreadsheets/d/1e7fxO79EXfscZs9iugG-fvCTO9tVVY3CPz3GUPYYOhs/export?format=csv&gid=166770249
